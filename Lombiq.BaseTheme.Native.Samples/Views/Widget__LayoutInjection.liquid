{{ 'text-center' | zone-classes: zone: 'Footer' }}
{{ 'layoutAside' | zone-classes: zone: 'AsideFirst' }}
{{ 'layoutAside, layoutAside_anotherClass' | zone-classes: zone: 'AsideSecond' }}
{{ 'unwanted-class' | zone-classes: zone: 'AsideSecond', remove: true }}

{% zone "Header" %}
<div class="navbar">
    <div class="navbar-brand">{{ Site.SiteName }}</div>
</div>
<p class="zoneInsertionExample_header">
    {{ 'Here you can easily inject shapes into the zones, kind of like always enabled widgets.' | t }}
</p>
{% endzone %}
